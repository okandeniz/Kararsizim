# Bu dosyayı `.env` olarak kopyala ve değerleri doldur. `.env` commit EDİLMEZ.

# Django gizli anahtarı. Üretmek için:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Yerelde True, production'da False olmalı (varsayılan: False)
DEBUG=True

# Virgülle ayrılmış alan adları. Vercel için kendi alan adını yaz (proje-adin.vercel.app);
# `.vercel.app` gibi wildcard kullanma, başkalarının uygulamaları da kabul edilir.
ALLOWED_HOSTS=127.0.0.1,localhost

# Virgülle ayrılmış, https:// ile başlayan kaynaklar. Vercel için: https://proje-adin.vercel.app
# (`https://*.vercel.app` kullanma).
CSRF_TRUSTED_ORIGINS=

# Boş bırakılırsa yerel SQLite (db.sqlite3) kullanılır.
# Supabase Postgres için:
#   Vercel (çalışma zamanı): transaction pooler, port 6543
#   Yerelden migration:      session pooler, port 5432
DATABASE_URL=

# Hız sınırları (oy, kayıt, giriş, anket oluşturma). Varsayılan: açık.
# Sınırlar gerçek kullanıcıları engelliyorsa acil durumda False yapıp yeniden deploy et.
RATE_LIMITS_ENABLED=True
